{
  "name": "VoiceTT",
  "main": "index.js",
  "version": "0.0.0",
  "author": "youtonghy <hi@youtonghy.com>",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "expo start",
    "reset-project": "bun ./scripts/reset-project.js",
    "android": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "desktop:dev": "bun ./scripts/electron-dev.js",
    "desktop:build": "bun ./scripts/desktop-build.js",
    "desktop:start": "bun ./scripts/electron-start.js",
    "lint": "expo lint",
    "check:i18n": "bun ./scripts/check-i18n.js"
  },
  "build": {
    "appId": "com.unbaked0692.vtt",
    "productName": "VoiceTT",
    "directories": {
      "output": "dist"
    },
    "publish": "never",
    "files": [
      "web-build/**",
      "electron/**",
      "assets/**",
      "app.json",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js",
      "dependencies": {}
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "mac": {
      "identity": "-",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/images/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/images/icon.png"
    },
    "nsis": {
      "allowElevation": false,
      "include": "installer.nsh",
      "perMachine": false
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@internationalized/date": "^3.12.1",
    "@internationalized/number": "^3.6.6",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.18",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "base64-js": "^1.5.1",
    "expo": "~55.0.27",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.15",
    "expo-clipboard": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.16",
    "expo-file-system": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.15",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.16",
    "expo-print": "~55.0.16",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.15",
    "expo-sharing": "~55.0.21",
    "expo-splash-screen": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.19",
    "expo-web-browser": "~55.0.17",
    "heroui-native": "^1.0.3",
    "heroui-native-pro": "^1.0.0-beta.5",
    "i18next": "^25.5.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.0.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.6.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "trustedDependencies": [
    "@heroui-pro/react",
    "heroui-native-pro",
    "@zowe/secrets-for-zowe-sdk",
    "heroui-pro"
  ]
}
